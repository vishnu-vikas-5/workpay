# ==============================================================================
# WorkPay Environment Configuration Blueprint
# ==============================================================================

# Server Port
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# RazorpayX Payout API Configuration (Backend Only)
# Get credentials from: https://dashboard.razorpay.com/#/access/api-keys
# ------------------------------------------------------------------------------
# Leave empty or with 'demo' to run in WorkPay Sandbox Simulator mode
RAZORPAYX_KEY_ID=rzp_live_or_test_key_here
RAZORPAYX_KEY_SECRET=your_razorpayx_key_secret_here
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_business_account_number_here
RAZORPAYX_WEBHOOK_SECRET=your_razorpayx_webhook_secret_here

# ------------------------------------------------------------------------------
# Firebase Configuration (Client & Admin SDK)
# Get config from Firebase Console -> Project Settings -> General -> Web App
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

